  "expected_alerts": [
    {
      "dataset": "auth_sample.csv",
      "rule_id": "AUTH_BRUTE_FORCE",
      "source_ip": "203.0.113.50",
      "severity": "high",
      "confidence": "high",
      "time_start": "2025-03-14T09:15:02+00:00",
      "time_end": "2025-03-14T09:16:40+00:00",
      "supporting_event_count": 9,
      "evidence_expectations": {
        "failure_count": 8,
        "distinct_usernames": 4,
        "followed_by_success": true,
        "success_event_count": 1,
        "why": "8 failures in 56 s, 4 usernames (high confidence), one success 42 s after the last failure (high severity); time_end is the success"
      }
    },
    {
      "dataset": "network_sample.csv",
      "rule_id": "NET_PORT_SCAN",
      "source_ip": "203.0.113.50",
      "severity": "medium",
      "confidence": "high",
      "time_start": "2025-03-14T09:16:00+00:00",
      "time_end": "2025-03-14T09:16:17+00:00",
      "supporting_event_count": 18,
      "evidence_expectations": {
        "distinct_port_count": 18,
        "destination_ip": "10.0.0.5",
        "why": "18 ports in 17 s (threshold 15, below 45 so medium); 17 of 18 attempts rejected (94 percent, so high confidence)"
      }
    },
    {
      "dataset": "network_sample.csv",
      "rule_id": "NET_REPEATED_REJECTS",
      "source_ip": "10.0.0.31",
      "severity": "low",
      "confidence": "low",
      "time_start": "2025-03-14T09:40:00+00:00",
      "time_end": "2025-03-14T09:41:35+00:00",
      "supporting_event_count": 20,
      "evidence_expectations": {
        "rejected_count": 20,
        "why": "exactly the threshold of 20 in 95 s; every rejection hits 10.0.0.9 port 514, so confidence is low"
      }
    },
    {
      "dataset": "network_sample.csv",
      "rule_id": "NET_HIGH_VOLUME",
      "source_ip": "10.0.0.40",
      "severity": "medium",
      "confidence": "low",
      "time_start": "2025-03-14T11:42:30+00:00",
      "time_end": "2025-03-14T11:42:30+00:00",
      "supporting_event_count": 1,
      "evidence_expectations": {
        "bucket_start": "2025-03-14T11:40:00+00:00",
        "bucket_bytes_sent": 12000000,
        "baseline_bytes": 1050000,
        "eligible_bucket_count": 9,
        "baseline_scope": "this_source_ip_only",
        "why": "12,000,000 bytes is at least 10,000,000 and at least 5 times the host's own median of 1,050,000"
      }
    },
    {
      "dataset": "auth_sample.csv + network_sample.csv",
      "rule_id": "CORR_AUTH_NET",
      "source_ip": "203.0.113.50",
      "severity": "critical",
      "confidence": "high",
      "time_start": "2025-03-14T09:15:02+00:00",
      "time_end": "2025-03-14T09:16:40+00:00",
      "supporting_event_count": 27,
      "evidence_expectations": {
        "link_value": "203.0.113.50",
        "gap_seconds": 0,
        "destination_match": true,
        "why": "login burst and port scan overlap in time; the burst has a linked success so severity is critical; both target 10.0.0.5 so confidence is high"
      }
    }
  ],
